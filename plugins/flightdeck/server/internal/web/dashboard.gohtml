<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
:root { color-scheme: light dark; --bg:#fbfbfa; --fg:#1c1b19; --dim:#5f5c56; --line:#e0ddd6;
        --card:#ffffff; --warn:#8a5a00; --crit:#8f1d1d; --ok:#1f6b3a; --accent:#2f5fb3; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#16181c; --fg:#e6e4e0; --dim:#9a978f; --line:#2c3037; --card:#1c1f24;
          --warn:#e0a33a; --crit:#f08a8a; --ok:#77d39b; --accent:#8fb2f0; }
}
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:14px/1.55 ui-sans-serif,system-ui,
       "Noto Sans KR","Apple SD Gothic Neo",sans-serif; }
header { padding:14px 18px; border-bottom:1px solid var(--line); }
header { position:relative; }
form.logout { position:absolute; top:12px; right:18px; margin:0; }
form.logout button { font-size:12px; padding:2px 8px; color:var(--dim); }
h1 { font-size:16px; margin:0 0 4px; letter-spacing:.02em; }
h2 { font-size:15px; margin:0; }
h3 { font-size:13px; margin:14px 0 6px; color:var(--dim); }
main { padding:0 18px 40px; max-width:1400px; }
section { margin:18px 0; padding:12px 14px; background:var(--card);
          border:1px solid var(--line); border-radius:6px; }
.shead { display:flex; flex-wrap:wrap; gap:8px; align-items:baseline; justify-content:space-between; }
.derived { color:var(--dim); font-size:12px; font-variant-numeric:tabular-nums; }
.dim { color:var(--dim); }
.mono { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; }
.err { color:var(--crit); font-size:13px; margin:6px 0; }
.notice { color:var(--ok); font-size:13px; margin:6px 0; }
.update-status { position:fixed; right:18px; bottom:14px; z-index:10; max-width:520px; margin:0;
                 padding:8px 10px; background:var(--card); border:1px solid var(--crit); border-radius:5px; }
.empty { color:var(--dim); font-size:13px; margin:8px 0; }
.tier { color:var(--dim); font-size:12px; margin:4px 0 8px; }
nav a { color:var(--accent); margin-right:10px; text-decoration:none; }
nav a.on { font-weight:700; text-decoration:underline; }
.cards { display:grid; gap:10px; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); }
.card { border:1px solid var(--line); border-radius:5px; padding:10px; }
.card.self { border-color:var(--accent); }
.k { color:var(--dim); font-size:12px; }
.sig { display:flex; flex-wrap:wrap; gap:10px; font-size:12px; font-variant-numeric:tabular-nums; }
.sig .off { color:var(--dim); }
.claims { font-weight:600; font-size:13px; margin-bottom:4px; }
.badge { font-size:12px; margin-left:6px; }
.badge.quiet { color:var(--warn); }
.paths { font-size:12px; margin:6px 0 0; padding-left:16px; }
.none { color:var(--warn); font-size:12px; }
/* 종료 선언 — 닫으려다 롤백된 시도. 경고색보다 세게 낸다: 이 표기가 붙은 항목은
   "아직 안 한 일"이 아니라 "이미 끝났다고 선언됐던 일"이다. */
.decl { color:var(--crit); font-weight:600; font-size:12px; }
table { border-collapse:collapse; width:100%; font-size:13px; }
th, td { text-align:left; border-bottom:1px solid var(--line); padding:5px 8px; vertical-align:top; }
th { color:var(--dim); font-weight:600; font-size:12px; }
.bar { display:inline-block; height:8px; background:var(--accent); border-radius:2px; vertical-align:middle; }
form.write { margin:10px 0 0; padding:10px; border:1px dashed var(--line); border-radius:5px;
             display:flex; flex-wrap:wrap; gap:8px; align-items:end; }
form.write label { font-size:12px; color:var(--dim); display:flex; flex-direction:column; gap:3px; }
input, select, button { font:inherit; padding:4px 6px; background:var(--bg); color:var(--fg);
                        border:1px solid var(--line); border-radius:4px; }
button { cursor:pointer; }
button[disabled] { cursor:not-allowed; opacity:.55; }
.lv-crit { color:var(--crit); font-weight:600; }
.lv-warn { color:var(--warn); }
.lv-ok { color:var(--ok); }
.lv-unknown { color:var(--dim); }
.stale { color:var(--warn); font-weight:600; }
.note { border-left:2px solid var(--line); padding-left:8px; margin:8px 0; }
.note .body { white-space:pre-wrap; font-size:12px; }
  .bar { display:inline-block; width:120px; height:8px; border-radius:4px;
         background:rgba(127,127,127,.25); vertical-align:middle; overflow:hidden; }
  .bar > i { display:block; height:100%; width:var(--pct,0%); border-radius:4px; background:currentColor; }
  /* 접기 — 긴 목록은 5건만 보이고 나머지는 더보기로 조금씩 연다.
     개수는 항상 보인다: 몇 건인지를 감추면 "없다"와 "접혀 있다"가 구분되지 않는다. */
  .fold > .fold-row[hidden] { display:none; }
  .more { margin-top:6px; font-size:12px; padding:3px 10px; border-radius:6px;
          border:1px solid currentColor; background:transparent; color:inherit; cursor:pointer; opacity:.8; }
  .more:hover { opacity:1; }
  .count { opacity:.65; font-weight:400; font-size:.85em; }
  /* 프로젝트 줄 접기 — JS 없이 <details> 하나로 닫는다. */
  details.pfold { display:inline-block; vertical-align:baseline; margin-left:6px; }
  details.pfold > summary { cursor:pointer; color:var(--dim); font-size:12px; }
  details.pfold[open] { display:block; margin:6px 0 0; }
  details.pfold a { margin-right:10px; }
  /* 표시 축 버튼 — 사유가 없는 클릭 하나짜리라 쓰기 폼(.write)과 다른 모양이다. */
  button.ax { border:none; background:transparent; color:var(--dim); cursor:pointer;
              font-size:12px; padding:0 4px; }
  button.ax:hover { color:var(--fg); }
</style>
</head>
<body>

{{/* 자동 갱신은 이 루트만 바꾼다. 스크립트는 밖에 남아서 EventSource 를 하나만 유지한다.
     JS 가 없으면 이 정적 화면이 그대로 남는다 — 문서 전체를 자동 탐색하는 폴백은 없다. */}}
<div id="dashboard" data-refresh="{{.Refresh}}" data-sse-path="{{.SSEPath}}"
     data-sse-project="{{.Project.ID}}">
<header>
  <h1>{{.Title}}</h1>
  <div class="derived">{{.Now}} · {{.HealthLine}} · 디스크: <span class="lv-{{.Disk.Level}}">{{.Disk.Text}}</span></div>
  {{if .Projects}}
  {{/* ★ 폼 하나에 버튼 여럿이다. 프로젝트마다 폼을 만들면 폼이 프로젝트 수만큼 늘고,
       render_test.go 의 상한이 세는 축이 통째로 무의미해진다. */}}
  <form class="pview" method="post" action="actions/project-view?key={{.WriteKey "project-view"}}">
  {{/* ★ .Project.ID 가 아니라 .Current 다 — NotFound 갈래에서도 이 줄의 버튼이 살아
       있어야 하는데, 그 갈래는 .Project 가 아직 제로값이다(Page.Current 주석 참고). */}}
  <input type="hidden" name="project" value="{{.Current}}">
  {{/* ★ 버튼마다 formaction 으로 자기만의 멱등 키를 낸다("project-view:<축>:<대상 id>").
       WriteKey 는 렌더 시각(초 단위)만 넣으므로, 폼의 action 키 하나를 버튼 전부가
       공유하면 303 리다이렉트 뒤 같은 초 안에 그려진 새 페이지에서 **다른** 버튼을
       눌렀을 때 같은 키·다른 본문이 되어 Fingerprint 불일치로 409(Conflict)가 난다
       (리뷰 Important-2, 실측). 회수·폐기는 사유를 적어야 해서 왕복이 길어 이 함정을
       안 겪었지만, 핀·보관은 줄을 정리하려고 연달아 누르는 것이 정상 사용 흐름이라
       왕복이 짧다.
       ★ 대상 id 뿐 아니라 **축까지** 키에 넣는다 — id 만 넣으면 같은 프로젝트를
       핀→(리로드)→보관처럼 같은 초 안에 연달아 눌러도 여전히 같은 키·다른 본문으로
       충돌한다. 축까지 넣으면 그 조합도 서로 다른 키가 되어 각각 독립된 쓰기로
       처리된다 — 정확히 같은 버튼을 두 번 누르는 것(더블클릭)만 같은 키·같은 본문이
       되어 멱등의 원래 의미(재생)대로 접힌다. */}}
  <nav>프로젝트:
    {{range .Nav.Shown}}<a class="{{if .On}}on{{end}}" href="?project={{.ID}}">{{.ID}}</a
      >{{if .Pinned}}<button class="ax" name="axis" value="unpin:{{.ID}}"
          formaction="actions/project-view?key={{$.WriteKey (printf "project-view:unpin:%s" .ID)}}"
          title="핀 해제">★</button
      >{{else}}<button class="ax" name="axis" value="pin:{{.ID}}"
          formaction="actions/project-view?key={{$.WriteKey (printf "project-view:pin:%s" .ID)}}"
          title="핀">☆</button>{{end}}{{end}}
    {{with .Nav.NoPins}}<span class="k">{{.}}</span>{{end}}
    {{/* 접기는 <details> 다 — JS 를 안 쓴다. 이 페이지의 다른 접기(.fold/.more)는 스크립트로
         접어서 JS 가 없으면 전부 펴지는데, 그 폴백은 긴 목록에는 옳지만 이 줄에는 반대다:
         스크립트가 없어도 접혀 있어야 이 축이 성립한다. */}}
    {{with .Nav.FoldedLine}}
    <details class="pfold"><summary>{{.}}</summary>
      {{range $.Nav.Folded}}<a href="?project={{.ID}}">{{.ID}}</a
        ><button class="ax" name="axis" value="pin:{{.ID}}"
            formaction="actions/project-view?key={{$.WriteKey (printf "project-view:pin:%s" .ID)}}"
            title="핀">☆</button
        ><button class="ax" name="axis" value="archive:{{.ID}}"
            formaction="actions/project-view?key={{$.WriteKey (printf "project-view:archive:%s" .ID)}}"
            title="보관 — 줄에서 뺀다">보관</button>{{end}}
      {{if $.Nav.Archived}}
      <div class="k">보관:
        {{range $.Nav.Archived}}<a class="dim" href="?project={{.ID}}">{{.ID}}</a>
          <span class="k">({{.LastSession}})</span
          ><button class="ax" name="axis" value="unarchive:{{.ID}}"
              formaction="actions/project-view?key={{$.WriteKey (printf "project-view:unarchive:%s" .ID)}}"
              title="되돌린다">되돌리기</button>{{end}}
      </div>
      {{end}}
    </details>
    {{end}}
  </nav>
  </form>
  {{end}}
  {{/* ★ POST 다. GET 링크로 두면 브라우저·확장의 링크 프리페치가 눌러서 로그아웃이
       사람 의사 없이 일어난다. 상대경로인 이유는 이 페이지의 다른 폼과 같다.
       ★ 인증이 꺼진 서버에서도 보인다 — 그 사실을 화면에 실으려면 Page 에 축이 하나
       늘고, 눌러도 303 으로 여기 돌아올 뿐이라 틀린 동작이 아니다. */}}
  <form class="logout" method="post" action="logout"><button type="submit">로그아웃</button></form>
</header>

{{with .Notice}}<p class="notice" style="padding:0 18px">{{.}}</p>{{end}}
{{with .Error}}<p class="err" style="padding:0 18px">{{.}}</p>{{end}}

{{if .HasProject}}
<main>

{{/* ─────────────────────────── ① 지금 ─────────────────────────── */}}
<section id="now">
  <div class="shead">
    <h2>① 지금 — 잡혀 있는 작업</h2>
    <span class="derived">{{.Live.Window}} · {{.Live.Derived}}</span>
  </div>
  {{template "pfail" .Live.Panel}}
  {{with .Live.Empty}}<p class="empty">{{.}}</p>{{end}}
  {{with .Live.Folded}}<p class="dim">{{.}}</p>{{end}}
  {{with .Live.OutOfWindow}}<p class="dim">{{.}}</p>{{end}}
  <div class="cards">
    {{range .Live.Sessions}}
    <div class="card{{if .IsSelf}} self{{end}}">
      {{/* 선점이 이 카드의 존재 이유다 — 머리줄에 둔다. 항목 id 를 전부 낸다(안 접는다) */}}
      <div class="claims mono">{{join ", " .Claims}}</div>
      <div><b>{{if .Label}}{{.Label}}{{else}}(라벨 없음){{end}}</b>
        <span class="k mono">{{.Short}}</span>
        <span class="k">· {{.State}}{{if .BlockedWhy}} ({{.BlockedWhy}}){{end}}</span>
        {{if .OpenedAge}}<span class="k">· 열림 {{.OpenedAge}}</span>{{end}}
        <span class="badge{{if not .HasActivity}} quiet{{end}}">{{if .HasActivity}}●{{else}}○{{end}} {{.Activity}}</span>
        {{if not .Derived}}<span class="k none">· 파생 안 읽음(창 밖)</span>{{end}}
      </div>
      <div class="k mono">{{.Worktree}}</div>
      <div class="k">
        브랜치: {{if .Branch}}<span class="mono">{{.Branch}}</span>{{end}}{{with .BranchNote}}<span class="none">{{.}}</span>{{end}}
        · main 대비: {{if .Ahead}}{{.Ahead}}{{end}}{{with .AheadNote}}<span class="none">{{.}}</span>{{end}}
      </div>
      <div class="sig">
        {{range .Signals}}
        <span class="{{if not .Known}}off{{end}}">{{.Label}} {{.Age}}</span>
        {{end}}
      </div>
      <div class="k">발자국: {{if .HasPaths}}{{.Footprint}}{{else}}<span class="none">{{.Footprint}}</span>{{end}}</div>
      {{if .Paths}}
      <ul class="paths mono">
        {{range .Paths}}<li>{{.}}</li>{{end}}
        {{if .MorePaths}}<li class="dim">외 {{.MorePaths}}건</li>{{end}}
      </ul>
      {{end}}
      {{with .LastNote}}
      <div class="note"><span class="k">최근 판단 [{{.Kind}}] {{.At}} ({{.Age}})</span>
        <div class="body">{{if .Title}}{{.Title}} — {{end}}{{.Body}}</div></div>
      {{end}}
      {{with .DeriveError}}<div class="err">파생 결손: {{.}}</div>{{end}}
    </div>
    {{end}}
  </div>

  {{/* 쓰기 ① — 선점 회수. 사유 필수. 회수 행위 자체가 판단(decision)으로 원장에 남는다 */}}
  <form class="write" method="post" action="actions/reclaim?key={{.WriteKey "reclaim"}}">
    <input type="hidden" name="project" value="{{.Project.ID}}">
    <label>회수할 선점
      <select name="item" required {{if not .Live.Targets}}disabled{{end}}>
        {{/* 제목과 종료 선언을 **뒤에** 붙인다. `{{.ItemID}} ← ` 접두는 actions_test.go 가
             선점의 생사를 재는 자리라(회수 전/후 두 번) 그 모양을 안 건드린다. */}}
        {{range .Live.Targets}}<option value="{{.ItemID}}" data-revision="{{.Revision}}">{{.ItemID}} ← {{.Holder}} ({{.Live}}{{if .Since}}, {{.Since}}부터{{end}}){{with .Title}} · {{.}}{{end}}{{with .CloseDeclared}} · {{template "declText" .}}{{end}}</option>{{end}}
        {{if not .Live.Targets}}<option>회수할 선점이 없다</option>{{end}}
      </select>
    </label>
    <label>사유(필수)
      <input name="reason" required minlength="4" maxlength="2000" size="46"
             placeholder="무엇을 보고 회수하는가 — 신호 나이·발자국·선점 시각을 근거로">
    </label>
    <button type="submit" {{if not .Live.Targets}}disabled{{end}}>선점 회수</button>
    <span class="k">근거 다섯 축은 위 카드에 있고, 여섯째(종료 선언)는 이 줄에 있다.
      회수는 사람만 하고, 사유는 원장에 남는다.</span>
  </form>
</section>

{{/* ─────────────────────── ② 미확인 결과 ─────────────────────── */}}
<section id="unacked">
  <div class="shead">
    <h2>② 미확인 결과</h2>
    <span class="derived">{{.Unacked.Derived}}</span>
  </div>
  <p class="tier">{{.Unacked.Tier}}</p>
  {{template "pfail" .Unacked.Panel}}
  {{with .Unacked.Empty}}<p class="empty">{{.}}</p>{{end}}
  {{if .Unacked.Jobs}}
  <table>
    <tr><th>잡</th><th>종류</th><th>항목</th><th>상태</th><th>실패 종류</th><th>끝난 시각</th><th>로그 꼬리</th></tr>
    {{range .Unacked.Jobs}}
    <tr><td class="mono">{{.ID}}</td><td>{{.Kind}}</td><td class="mono">{{.ItemID}}</td>
        <td>{{.State}}</td><td>{{.FailKind}}</td><td>{{.Ended}}</td><td class="mono">{{.LogTail}}</td></tr>
    {{end}}
  </table>
  {{end}}
  {{/* 쓰기 ④ — 잡 우회 기록. Tier B 라 자리만 낸다. 지우면 "없다"와 "안 본다"가 구분되지 않는다 */}}
  <p><button type="button" disabled title="Tier B — 러너가 서면 열린다">잡 우회 기록(사유 필수) · Tier B</button></p>
</section>

{{/* ──────────────────────────── ③ 큐 ──────────────────────────── */}}
<section id="queue">
  <div class="shead">
    <h2>③ 큐 <span class="count">{{len .Queue.Items}}건</span></h2>
    <span class="derived">{{.Queue.Derived}}</span>
  </div>
  {{/* 행마다 이 경고를 달지 않는다 — 30행에 같은 문구가 붙으면 상시 점등된 경고가 되어
       판별력이 0이 된다(judge/eligible.go 의 OverlapsWithLive 주석과 같은 규율). 대신
       여기 한 번만 적는다: 종료 선언 축의 수는 하한이다 — 원장에 안 써진 마무리는
       배지 없음과 구분되지 않는다(빈 칸이 "선언 없음"과 "유실"을 가르지 못한다). */}}
  <p class="k">종료 선언 배지가 붙은 항목의 수는 하한이다. 배지가 없는 항목도 원장에
    안 써진 마무리가 있었을 수 있다 — 이 축에서는 영영 0으로 보인다.</p>
  {{template "pfail" .Queue.Panel}}
  {{with .Queue.Empty}}<p class="empty">{{.}}</p>{{end}}
  {{if .Queue.Items}}
  <table>
    <tr><th>항목</th><th>제목</th><th>상태</th><th>선점</th><th>경로</th><th>선행(의존)</th><th>기대는 항목</th></tr>
    <tbody class="fold">{{range .Queue.Items}}
    <tr class="fold-row">
      <td class="mono">{{.ID}}</td>
      <td>{{.Title}}<div class="k">{{.Body}}</div>
        {{if .Labels}}<div class="k">라벨: {{join ", " .Labels}}</div>{{end}}</td>
      {{/* 상태 칸에 붙인다 — 이 배지는 "open 인데 이미 닫으려던 적이 있다"라는
           상태에 대한 단서지 별개의 축이 아니다. 열을 늘리면 표가 옆으로 터진다. */}}
      <td>{{.State}}{{with .CloseDeclared}}<div class="decl">{{template "declText" .}}</div>{{end}}</td>
      <td class="mono">{{if .Holder}}{{.Holder}}{{if .Since}}<div class="k">{{.Since}}부터</div>{{end}}{{else}}—{{end}}</td>
      <td class="mono">{{if .Paths}}{{join " · " .Paths}}{{else}}<span class="none">경로 선언 없음</span>{{end}}</td>
      <td>{{if .After}}{{range .After}}<div>{{.}}</div>{{end}}{{else}}<span class="dim">없음</span>{{end}}</td>
      <td>{{if lt .Dependents 0}}<span class="none">못 읽음</span>{{else}}{{.Dependents}}{{end}}</td>
    </tr>
    {{end}}</tbody>
  </table>
  {{end}}

  <h3>탈락 사유 분포 {{with .Queue.Window}}<span class="dim">— {{.}}</span>{{end}}</h3>
  {{with .Queue.StatsErr}}<p class="empty">{{.}}</p>{{end}}
  {{if .Queue.Stats.Reasons}}
  <p class="k">판정 {{.Queue.Stats.Evals}}회 · 추천 있음 {{.Queue.Stats.Picked}}회 · 적격 0건 {{.Queue.Stats.None}}회 · 탈락 줄 {{.Queue.Stats.Total}}
    · 적격이나 추천 순위 밖 {{.Queue.Stats.NotTop}}건(not-top 은 거르는 축이 아니라 분포에서 뺀다)</p>
  <table>
    <tr><th>사유 코드</th><th>건수</th><th>예시 항목</th><th>상세 한 줄</th></tr>
    {{range .Queue.Stats.Reasons}}
    <tr><td class="mono">{{.Reason}}</td>
        <td>{{.Count}} <span class="bar" style="width:{{.Count}}px"></span></td>
        <td class="mono">{{join ", " .Items}}</td>
        <td class="k">{{.Example}}</td></tr>
    {{end}}
  </table>
  {{else}}{{if not .Queue.StatsErr}}<p class="empty">탈락 줄이 0건이다 — 판정은 돌았고 아무도 탈락하지 않았다.</p>{{end}}{{end}}

  {{/* 쓰기 ② — 항목 폐기. 사유 필수. close_reason 과 판단 양쪽에 남는다 */}}
  <form class="write" method="post" action="actions/drop?key={{.WriteKey "drop"}}">
    <input type="hidden" name="project" value="{{.Project.ID}}">
    <label>폐기할 항목
      <select name="item" required {{if not .Queue.Targets}}disabled{{end}}>
        {{range .Queue.Targets}}<option value="{{.ID}}" data-revision="{{.Revision}}">{{.ID}}{{with .Title}} — {{.}}{{end}}{{with .CloseDeclared}} · {{template "declText" .}}{{end}}</option>{{end}}
        {{if not .Queue.Targets}}<option>폐기할 항목이 없다</option>{{end}}
      </select>
    </label>
    <label>사유(필수)
      <input name="reason" required minlength="4" maxlength="2000" size="46"
             placeholder="왜 안 하기로 했는가 — 이 문장이 나중에 유일한 근거다">
    </label>
    <button type="submit" {{if not .Queue.Targets}}disabled{{end}}>항목 폐기</button>
    {{/* 이 한 줄이 위 배지의 뜻을 정한다. 배지만 있고 뜻이 없으면 사람은 그것을 장식으로 읽는다. */}}
    <span class="k">★ <b>종료 선언</b>이 붙은 항목은 이미 한 번 닫으려다 롤백된 것이다 —
      연결된 판단부터 읽어라(그 본문은 롤백과 함께 사라졌다). 그 수는 하한이다: 원장에
      안 써진 마무리가 있을 수 있다.</span>
  </form>
</section>

{{/* ─────────────────────── ④ 랜딩 이력 ─────────────────────── */}}
<section id="landing">
  <div class="shead">
    <h2>④ 랜딩 이력 <span class="count">{{len .Landing.Closed}}건</span></h2>
    <span class="derived">{{.Landing.Derived}}</span>
  </div>
  <p class="tier">{{.Landing.Tier}}</p>
  {{template "pfail" .Landing.Panel}}
  {{with .Landing.Empty}}<p class="empty">{{.}}</p>{{end}}
  {{if .Landing.Closed}}
  <table>
    <tr><th>항목</th><th>제목</th><th>결과</th><th>랜딩 sha</th><th>종료</th><th>사유</th></tr>
    <tbody class="fold">{{range .Landing.Closed}}
    <tr class="fold-row"><td class="mono">{{.ID}}</td><td>{{.Title}}</td><td>{{.State}}</td>
        <td class="mono">{{if .Holder}}{{.Holder}}{{else}}<span class="dim">—</span>{{end}}</td>
        <td>{{.Since}}</td><td class="k">{{.Body}}</td></tr>
    {{end}}</tbody>
  </table>
  {{end}}

  {{/* 레인 절. **새 <section> 이 아니라 ④ 안쪽 <h3>** 이다 — 절 개수는 여섯으로 고정이고
       그 수가 화면의 골격을 잠근다(render_test.go). Task 6 부터 표는 자원별로 갈린다 —
       <h4> 하나가 자원 하나다(<h3> 을 새로 열지 않는다. 그러면 절 개수 락과 laneSectionOf
       헬퍼가 "다음 <h3>" 을 경계로 자르는 것 둘 다 깨진다). */}}
  <h3>랜딩 레인 — 줄과 회수 <span class="count">{{len .Landing.Lane}}줄</span></h3>
  <p class="k">자동 만료는 없다. 회수는 사람이 하고, 대상은 레인이 아니라 <b>줄 행</b>이다 —
     대기 중 좀비도 같은 문법으로 빠진다. 판정 근거는 아래 두 숫자다: 획득 경과와 마지막 신호 나이.</p>
  {{with .Landing.LaneErr}}<p class="err">{{.}}</p>{{end}}
  {{with .Landing.LaneEmpty}}<p class="empty">{{.}}</p>{{end}}
  {{range .Landing.Resources}}
  <h4>{{.Resource}}</h4>
  {{/* 이 자원만의 정합 어긋남 — LandingPanel.LaneWarn(레인 전체 한 줄)이 옮겨온 자리다. */}}
  {{with .Warn}}<p class="err">{{.}}</p>{{end}}
  <table>
    <tr><th>순번</th><th>세션</th><th>대기 경과</th><th>마지막 신호</th><th>획득 경과</th></tr>
    {{range .Rows}}
    <tr{{if .Holder}} class="lane-holder"{{end}}>
      <td class="mono">{{if .Missing}}<span class="dim">없음</span>{{else}}{{.RowID}}{{end}}</td>
      <td class="mono">{{.Session}}</td>
      <td>{{if .Waiting}}{{.Waiting}}{{else}}<span class="dim">—</span>{{end}}</td>
      {{/* 빈칸은 "관측 실패이거나 신호가 없다"다. 둘을 갈라 적으려면 없는 정보를 지어내야 한다. */}}
      <td>{{if .Signal}}{{.Signal}}{{else}}<span class="dim">—</span>{{end}}</td>
      <td>{{if .Holder}}<b>{{.Held}}</b>{{else}}<span class="dim">—</span>{{end}}</td>
    </tr>
    {{end}}
  </table>
  {{end}}

  {{/* 쓰기 ③ — 레인 회수. 사유 필수. 회수 행위가 판단(decision)으로 원장에 남는다.
       CLI 의 fd lane release 와 **같은 함수**를 부른다. */}}
  <form class="write" method="post" action="actions/lane-release?key={{.WriteKey "lane-release"}}">
    <input type="hidden" name="project" value="{{.Project.ID}}">
    <label>회수할 줄 행
      <select name="item" required {{if not .Landing.Lane}}disabled{{end}}>
        {{range .Landing.Lane}}{{if not .Missing}}<option value="{{.RowID}}" data-revision="{{.Revision}}">{{.RowID}} ← {{.Session}} ({{if .Holder}}점유 중, {{.Held}}{{else}}대기 {{.Waiting}}{{end}})</option>{{end}}{{end}}
        {{if not .Landing.Lane}}<option>회수할 줄 행이 없다</option>{{end}}
      </select>
    </label>
    <label>사유(필수)
      <input name="reason" required minlength="4" maxlength="2000" size="46"
             placeholder="왜 남의 랜딩을 끊는가 — 획득 경과·신호 나이를 근거로">
    </label>
    <button type="submit" {{if not .Landing.Lane}}disabled{{end}}>레인 회수</button>
    <span class="k">레인 정지/재개는 여전히 Tier B(러너)다 — 여기서 여는 것은 회수 하나뿐이다.</span>
  </form>

  <h3>스냅숏 — 재계산이 불가능한 수치</h3>
  <p class="k">{{.Landing.Current}}</p>
  {{with .Landing.SnapErr}}<p class="empty">{{.}}</p>{{end}}
  {{if .Landing.Snapshots}}
  <table>
    <tr><th>파트</th><th>진척</th><th>항목(완료·부분·없음)</th><th>담당</th><th>판정 시각</th><th>낡음</th><th>근거</th></tr>
    {{range .Landing.Snapshots}}
    <tr>
      <td class="mono">{{.Key}}</td>
      {{with .Progress}}
        {{/* 값이 진척 모양일 때만 막대로 그린다. 아니면 원문을 그대로 보인다 —
             표시를 못 한다고 값을 감추지 않는다. */}}
        <td><span class="bar" style="--pct:{{.Pct}}%"><i></i></span> <b>{{.Pct}}%</b>{{with .Delta}} <span class="k">{{.}}</span>{{end}}</td>
        <td class="k">{{.Total}} — 완료 {{.Done}} · 부분 {{.Partial}} · 없음 {{.Nothing}}</td>
        <td class="k">{{.Owner}}</td>
      {{else}}
        <td><b>{{.Value}}</b></td><td class="k">—</td><td class="k">{{.Method}}</td>
      {{end}}
      <td>{{.Computed}}</td>
      <td>{{if .Verdict.Warn}}<span class="stale">{{.Verdict.Reason}}</span>{{else}}<span class="lv-ok">{{.Verdict.Reason}}</span>{{end}}</td>
      <td class="k">{{.Evidence}}</td>
    </tr>
    {{end}}
  </table>
  {{end}}
  {{/* 쓰기 ③ — 레인 정지/재개. Tier B 라 자리만 낸다 */}}
  <p><button type="button" disabled title="Tier B — 러너가 서면 열린다">레인 정지/재개(사유 필수) · Tier B</button></p>
</section>

{{/* ─────────────────────────── ⑤ 막힘 ─────────────────────────── */}}
<section id="blocked">
  <div class="shead">
    <h2>⑤ 막힘 <span class="count">{{len .Blocked.Notes}}건</span></h2>
    <span class="derived">{{.Blocked.Derived}}</span>
  </div>
  {{template "pfail" .Blocked.Panel}}
  <p class="k">자원 임계 — 디스크: <span class="lv-{{.Blocked.Disk.Level}}">{{.Blocked.Disk.Text}}</span>
    <span class="dim">(임계 경고는 자원에만 붙인다. 세션에는 안 붙인다 — 상시 점등된 경고는 판별력이 0이다.)</span></p>
  {{with .Blocked.Empty}}<p class="empty">{{.}}</p>{{end}}
  {{if .Blocked.Held}}
  <h3>쥐어진 자원</h3>
  <table>
    <tr><th>자원</th><th>점유자</th><th>획득</th><th>경과</th></tr>
    {{range .Blocked.Held}}
    <tr><td class="mono">{{.Resource}}</td><td class="mono">{{.Holder}}</td><td>{{.Since}}</td><td>{{.Age}}</td></tr>
    {{end}}
  </table>
  {{end}}
  {{if .Blocked.Sessions}}
  <h3>blocked 상태 세션</h3>
  {{range .Blocked.Sessions}}
  <div class="note"><span class="k mono">{{.Short}}</span> {{.Label}} — {{if .BlockedWhy}}{{.BlockedWhy}}{{else}}<span class="none">사유 없음</span>{{end}}</div>
  {{end}}
  {{end}}
  {{if .Blocked.Notes}}
  <h3>막힘 판단(blocked)</h3>
  <div class="fold">{{range .Blocked.Notes}}<div class="fold-row">{{template "note" .}}</div>{{end}}</div>
  {{end}}
  {{if .Blocked.Asks}}
  <h3>요청(ask) — 남이 건드리면 곤란한 것</h3>
  <div class="fold">{{range .Blocked.Asks}}<div class="fold-row">{{template "note" .}}</div>{{end}}</div>
  {{end}}
</section>

{{/* ─────────────────────── ⑥ 판단 검색 ─────────────────────── */}}
<section id="search">
  <div class="shead">
    <h2>⑥ 판단 검색 <span class="count">{{len .Search.Results}}건</span></h2>
    <span class="derived">{{.Search.Derived}}</span>
  </div>
  <form method="get" action="./">
    <input type="hidden" name="project" value="{{.Project.ID}}">
    <input type="search" name="q" value="{{.Search.Query}}" size="40" placeholder="판단 전문 검색(FTS5)">
    <button type="submit">검색</button>
  </form>
  <p class="k">{{.Search.Mode}}</p>
  {{template "pfail" .Search.Panel}}
  {{with .Search.Empty}}<p class="empty">{{.}}</p>{{end}}
  <div class="fold">{{range .Search.Results}}<div class="fold-row">{{template "note" .}}</div>{{end}}</div>
</section>

</main>
{{end}}
</div>
<p id="dashboard-update-status" class="err update-status" role="status" aria-live="polite" hidden></p>

<script>
// 자동 갱신은 문서를 다시 탐색하지 않는다. SSE 는 무효화 신호만 받고, 현재 URL 에서
// 새 데이터를 읽어 #dashboard 하나를 바꾼다. 주기 조회는 SSE 유실과 나이 표기를 되맞춘다.
(function () {
  "use strict";

  var ROOT_ID = "dashboard";
  var STEP = 5;
  var BURST_DELAY = 500;
  var inFlight = false;
  var pending = false;
  var updateTimer = 0;
  var pollTimer = 0;
  var pollMS = 0;
  var source = null;
  var sourceKey = "";
  var composing = false;
  var retryAfter = 0;

  function list(nodes) {
    return Array.prototype.slice.call(nodes);
  }

  function root() {
    return document.getElementById(ROOT_ID);
  }

  function setUpdateStatus(message) {
    var status = document.getElementById("dashboard-update-status");
    status.textContent = message || "";
    status.hidden = !message;
  }

  function scopeKey(node, selector) {
    var scope = node.closest("section, header") || root();
    var prefix = scope.id || scope.tagName.toLowerCase();
    return prefix + ":" + list(scope.querySelectorAll(selector)).indexOf(node);
  }

  function foldKey(box) {
    return scopeKey(box, ".fold");
  }

  function formStateKey(form) {
    var action = (form.getAttribute("action") || "").split("?")[0];
    return form.method + ":" + action + ":" + form.className;
  }

  // 폼 action 의 key 쿼리는 새 렌더의 멱등 키라 복원하지 않는다. 사용자가 바꿀 수 있는
  // 값만 action 경로+필드 이름으로 잇는다. hidden project 도 새 렌더 값을 그대로 쓴다.
  function editableControls(box) {
    var out = [];
    list(box.querySelectorAll("form")).forEach(function (form) {
      var formKey = formStateKey(form);
      var seen = {};
      list(form.querySelectorAll("input, select, textarea")).forEach(function (control) {
        var type = (control.getAttribute("type") || "").toLowerCase();
        if (["hidden", "submit", "button", "reset", "image", "file"].indexOf(type) >= 0) { return; }
        var base = control.tagName + ":" + type + ":" + (control.name || "");
        var ordinal = seen[base] || 0;
        seen[base] = ordinal + 1;
        out.push({form: formKey, key: formKey + ":" + base + ":" + ordinal, node: control});
      });
    });
    return out;
  }

  function captureUIState(box) {
    var state = {controls: {}, forms: {}, details: {}, folds: {}, active: ""};
    var active = document.activeElement;
    list(box.querySelectorAll("form.write")).forEach(function (form) {
      var target = form.querySelector('select[name="item"]');
      var option = target && target.selectedIndex >= 0 ? target.options[target.selectedIndex] : null;
      state.forms[formStateKey(form)] = {
        target: option ? option.value : "",
        revision: option ? option.dataset.revision || "" : ""
      };
    });
    editableControls(box).forEach(function (entry) {
      var control = entry.node;
      var value = {
        value: control.value,
        checked: control.checked,
        selected: control.tagName === "SELECT" ?
          list(control.options).filter(function (option) { return option.selected; })
            .map(function (option) { return option.value; }) : []
      };
      if (control === active) {
        state.active = entry.key;
        if (typeof control.selectionStart === "number") {
          value.selectionStart = control.selectionStart;
          value.selectionEnd = control.selectionEnd;
        }
      }
      state.controls[entry.key] = value;
    });
    list(box.querySelectorAll("details")).forEach(function (details) {
      state.details[scopeKey(details, "details")] = details.open;
    });
    list(box.querySelectorAll(".fold")).forEach(function (fold) {
      state.folds[foldKey(fold)] = list(fold.querySelectorAll(".fold-row"))
        .filter(function (row) { return !row.hidden; }).length;
    });
    return state;
  }

  function restoreUIState(box, state) {
    var active = null;
    var activeValue = null;
    var safeForms = {};
    list(box.querySelectorAll("form")).forEach(function (form) {
      var key = formStateKey(form);
      if (!form.classList.contains("write")) { safeForms[key] = true; return; }
      var saved = state.forms[key];
      var options = list(form.querySelectorAll('select[name="item"] option'));
      safeForms[key] = !!saved && !!saved.revision && options.some(function (option) {
        return option.value === saved.target && option.dataset.revision === saved.revision;
      });
    });
    editableControls(box).forEach(function (entry) {
      // 회수·폐기 폼은 선택 대상의 원시 지문까지 같을 때만 한 단위로 복원한다.
      // 대상이 사라지거나 점유자·선점 시각·신호가 바뀌면 사유와 포커스도 함께 버린다.
      if (!safeForms[entry.form]) { return; }
      var saved = state.controls[entry.key];
      if (!saved) { return; }
      var control = entry.node;
      if (control.tagName === "SELECT") {
        var found = list(control.options).some(function (option) {
          return saved.selected.indexOf(option.value) >= 0;
        });
        if (found) {
          list(control.options).forEach(function (option) {
            option.selected = saved.selected.indexOf(option.value) >= 0;
          });
        }
      } else if (control.type === "checkbox" || control.type === "radio") {
        control.checked = saved.checked;
      } else {
        control.value = saved.value;
      }
      if (entry.key === state.active) {
        active = control;
        activeValue = saved;
      }
    });
    list(box.querySelectorAll("details")).forEach(function (details) {
      var key = scopeKey(details, "details");
      if (Object.prototype.hasOwnProperty.call(state.details, key)) {
        details.open = state.details[key];
      }
    });
    if (active) {
      try { active.focus({preventScroll: true}); } catch (e) { active.focus(); }
      if (typeof activeValue.selectionStart === "number" && active.setSelectionRange) {
        active.setSelectionRange(activeValue.selectionStart, activeValue.selectionEnd);
      }
    }
  }

  // 접기 — 새 동적 루트에도 다시 건다. savedCounts 가 있으면 사용자가 연 행 수를 잇는다.
  // JS 가 없으면 행을 숨기지 않으므로 정보는 전부 남는다.
  function setupFolds(box, savedCounts) {
    list(box.querySelectorAll(".fold")).forEach(function (fold) {
      if (fold.dataset.foldReady) { return; }
      fold.dataset.foldReady = "true";
      var rows = list(fold.querySelectorAll(".fold-row"));
      if (rows.length <= STEP) { return; }
      var saved = savedCounts && savedCounts[foldKey(fold)];
      var shown = Math.min(rows.length, Math.max(STEP, saved || STEP));
      rows.forEach(function (row, index) { row.hidden = index >= shown; });
      var button = document.createElement("button");
      button.type = "button";
      button.className = "more";
      function label() {
        var left = rows.length - shown;
        button.textContent = left > 0 ?
          "더보기 " + Math.min(STEP, left) + "건 (남은 " + left + "건)" : "";
        button.hidden = left <= 0;
      }
      button.addEventListener("click", function () {
        rows.slice(shown, shown + STEP).forEach(function (row) { row.hidden = false; });
        shown = Math.min(shown + STEP, rows.length);
        label();
      });
      label();
      var anchor = fold.tagName === "TBODY" ? fold.closest("table") : fold;
      anchor.parentNode.insertBefore(button, anchor.nextSibling);
    });
  }

  function configOf(box) {
    var seconds = Number(box.dataset.refresh);
    return {
      refresh: isFinite(seconds) && seconds > 0 ? seconds * 1000 : 30000,
      path: box.dataset.ssePath || "",
      project: box.dataset.sseProject || ""
    };
  }

  function syncSource(config) {
    var key = config.path + "\n" + config.project;
    if (key === sourceKey) { return; }
    if (source) { source.close(); source = null; }
    sourceKey = key;
    if (!config.path || !window.EventSource) { return; }
    try {
      var eventURL = new URL(config.path, window.location.href);
      // 본문은 현재 프로젝트의 사건만 즉시 받는다. 다른 프로젝트 때문에 바뀌는 헤더 탐색 줄은
      // 아래 주기 조회가 최대 refresh 뒤에 맞춘다. project 가 비면 전 사건을 받아 빈 서버도 깨어난다.
      if (config.project) { eventURL.searchParams.set("project", config.project); }
      var path = eventURL.toString();
      var es = new EventSource(path);
      source = es;
      es.onmessage = function () { scheduleUpdate(); };
    } catch (e) {
      // 주기적 부분 갱신이 계속 받는다. 다음 렌더에서 설정이 바뀌면 다시 연결한다.
      sourceKey = "";
    }
  }

  function schedulePoll() {
    if (pollTimer || pollMS <= 0) { return; }
    pollTimer = window.setTimeout(function () {
      pollTimer = 0;
      scheduleUpdate(0);
      schedulePoll();
    }, pollMS);
  }

  function syncConfig() {
    var config = configOf(root());
    if (pollMS !== config.refresh) {
      pollMS = config.refresh;
      if (pollTimer) { window.clearTimeout(pollTimer); pollTimer = 0; }
    }
    schedulePoll();
    syncSource(config);
  }

  // 첫 사건 뒤 짧게 기다리는 leading/trailing throttle 이다. 타이머를 매 사건마다
  // 되감지 않으므로 사건이 계속 와도 굶지 않고, fetch 는 언제나 하나만 돈다.
  function scheduleUpdate(delay) {
    pending = true;
    if (inFlight || updateTimer) { return; }
    var wait = typeof delay === "number" ? delay : BURST_DELAY;
    wait = Math.max(wait, retryAfter - Date.now());
    updateTimer = window.setTimeout(function () {
      updateTimer = 0;
      updateDashboard();
    }, wait);
  }

  function replaceDashboard(markup) {
    if (composing) { pending = true; return; }
    var fresh = new DOMParser().parseFromString(markup, "text/html");
    var current = root();
    var next = fresh.getElementById(ROOT_ID);
    if (!current || !next) { throw new Error("dashboard root missing"); }
    var state = captureUIState(current);
    current.replaceWith(next);
    document.title = fresh.title;
    setupFolds(next, state.folds);
    restoreUIState(next, state);
    syncConfig();
  }

  function updateDashboard() {
    if (inFlight) { return; }
    if (composing) { scheduleUpdate(); return; }
    pending = false;
    inFlight = true;
    function finished(ok) {
      inFlight = false;
      // 서버가 HTML 을 못 낼 때도 SSE 사건마다 초당 두 번씩 재시도하면 원래의 폭주를
      // 다른 모양으로 되살린다. 실패 뒤에는 적어도 주기 조회 간격만큼 물러난다.
      retryAfter = ok ? 0 : Date.now() + pollMS;
      setUpdateStatus(ok ? "" : "자동 갱신 실패 — 표시된 데이터가 낡았을 수 있다. 연결·로그인을 확인하라. " +
        Math.ceil(pollMS / 1000) + "초 뒤 다시 시도한다.");
      if (pending) { scheduleUpdate(); }
    }
    fetch(window.location.href, {
      cache: "no-store",
      credentials: "same-origin",
      headers: {Accept: "text/html"}
    }).then(function (response) {
      var contentType = response.headers.get("Content-Type") || "";
      // 없는 프로젝트의 404도 대시보드가 의도해 그린 한 장이다. 그것까지 받으면 프로젝트가
      // 사라지거나 새로 생긴 뒤의 탐색 줄도 제자리에서 맞춰진다. 인증·서버 오류는 받지 않는다.
      if ((!response.ok && response.status !== 404) || contentType.indexOf("text/html") < 0) {
        throw new Error("dashboard update rejected");
      }
      return response.text();
    }).then(replaceDashboard).then(function () { finished(true); }, function () { finished(false); });
  }

  document.addEventListener("compositionstart", function (event) {
    if (root().contains(event.target)) { composing = true; }
  });
  document.addEventListener("compositionend", function () {
    composing = false;
    if (pending) { scheduleUpdate(0); }
  });

  var elementAPI = window.Element && window.Element.prototype;
  if (!window.fetch || !window.DOMParser || !window.URL || !elementAPI ||
      !elementAPI.closest || !elementAPI.replaceWith) {
    setUpdateStatus("이 브라우저는 제자리 데이터 갱신을 지원하지 않는다 — 정적 화면을 그대로 둔다.");
    return;
  }
  setupFolds(root(), {});
  syncConfig();
})();
</script>
</body>
</html>

{{define "pfail"}}
  {{with .Err}}<p class="err">{{.}}</p>{{end}}
  {{if .Fail}}
  <details class="k"><summary>못 읽은 파생 {{len .Fail}}축</summary>
    <ul>{{range .Fail}}<li><span class="mono">{{.Axis}}</span> — {{.Detail}}</li>{{end}}</ul>
  </details>
  {{end}}
{{end}}

{{define "note"}}
<div class="note">
  <span class="k">[{{.Kind}}] {{.At}}{{if .Age}} ({{.Age}}){{end}}
    {{if .Session}}· 세션 <span class="mono">{{.Session}}</span>{{end}}
    {{if .Links}}· {{join ", " .Links}}{{end}}
    {{/* 정정 축 — 옛 행 쪽 표식에는 역참조가 필요해 판단 검색(⑥)에서만 찬다.
         "정정됨"만 적고 어디로 갈지를 안 주면 반쪽이라 대체한 id 를 같이 낸다. */}}
    {{if .SupersededBy}}· <b>정정됨</b> → <span class="mono">{{.SupersededBy}}</span>{{end}}
    {{if .Supersedes}}· <span class="mono">{{.Supersedes}}</span> 를 대체{{end}}</span>
  {{if .Title}}<div><b>{{.Title}}</b></div>{{end}}
  <div class="body">{{.Body}}</div>
</div>
{{end}}

{{/* declText 는 CloseDeclared 한 값의 표기다. 값의 규약은 format.go 의 CloseDeclaredLabel 이
     정한다 — 빈 문자열은 "선언 없음"이라 호출부의 {{with}} 가 이미 걸러 여기 안 온다.
     "?" 는 CloseDeclUnread 다. **여기 한 자리에서만** 문장으로 옮긴다 — 세 표면(큐 표·
     회수 폼·폐기 폼)이 같은 사실을 다르게 말하면 그 자체가 이 항목이 고치는 병이다.
     한 줄로 쓴다: <option> 안에 들어가므로 줄바꿈이 그대로 새어 나간다. */}}
{{define "declText"}}{{if eq . "?"}}종료 선언 축을 못 읽었다 — 없다는 뜻이 아니다{{else}}{{.}}{{end}}{{end}}
