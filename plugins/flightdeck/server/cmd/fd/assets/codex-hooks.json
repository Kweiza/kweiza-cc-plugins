{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook session-start --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook user-prompt --harness codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook post-tool --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook pre-compact --harness codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook stop --harness codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__FD_HOOK_PATH__\" hook session-end --harness codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
